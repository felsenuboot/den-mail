<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Den Mail</vendor>
  <vendor_url>https://github.com/felsenuboot/den-mail</vendor_url>
  <action id="io.github.felsenuboot.DenMail.unlock">
    <description>Unlock Den Mail</description>
    <message>Authentication is required to show your mail again</message>
    <defaults>
      <allow_any>auth_self</allow_any>
      <allow_inactive>auth_self</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
  </action>
</policyconfig>
